{
  "manifest_version": 3,
  "name": "Dual-Stream Deepfake Detector",
  "version": "1.0",
  "description": "Detects compressed deepfake videos using dual-stream analysis.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}